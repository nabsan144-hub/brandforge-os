# ============================================================================
# BRANDFORGE OS — desktop app environment (app/)
# Copy to .env and fill in what you need. Every value here is OPTIONAL —
# the app runs fully offline with an empty .env (that's the product).
# Loaded by python-dotenv at startup; never commit the real .env.
# ============================================================================

# ---- storage ----
# Where campaigns/output/memory live. Default: ./output next to the app.
# BRANDFORGE_DATA_DIR=/path/to/data

# ---- AI providers (all optional; offline template mode works without any) ----
# Local LLM (offline-capable provider)
# # Anthropic (Claude) key, used by the copywriter/swarm path when present
# ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434
# Optional public image endpoint. Public-URL validation blocks private,
# loopback and link-local destinations; redirects are checked as well.
# BRANDFORGE_IMAGE_ENDPOINT=https://image.pollinations.ai/prompt

# ---- web search keys (optional; search degrades gracefully without them) ----
# BRAVE_API_KEY=
# TAVILY_API_KEY=

# ---- Telegram notifications (optional daemon feature) ----
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_CHAT_IDS=123456789

# ---- server mode (python server.py / desktop UI backend) ----
# Set when the app serves the hosted multi-user backend instead of local mode.
# BRANDFORGE_HOSTED=0
# Comma-separated allowed origins for CORS in server mode.
# BRANDFORGE_CORS_ORIGINS=http://localhost:5173
# Disable the built-in login for a trusted LAN-only deployment (DANGEROUS).
# BRANDFORGE_I_UNDERSTAND_NO_AUTH=0

# ---- background daemon (scheduled posts/heartbeat) ----
# BRANDFORGE_DAEMON=0

# ---- swarm chat rate limit ----
# Max swarm chat turns per minute (0 = default).
# BRANDFORGE_RATE_SWARM_CHAT=0

# ---- memory ----
# Max rows kept in long-term memory (SQLite LIKE fallback store).
# BRANDFORGE_MEMORY_MAX_ROWS=5000

# Advanced opt-in: public image service receives your prompt (default off).
BRANDFORGE_PUBLIC_IMAGES=0
