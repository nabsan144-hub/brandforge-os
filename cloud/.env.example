# --- v1.8 AI artwork scenes (optional; paid plans only) ---
# Provider: gemini (default) | openai | xai. The key is used for the operator's
# own account; customers never see or supply one. Without a key, banners stay
# deterministic vector SVG (the honest free-plan fallback).
AI_VISUALS_PROVIDER=gemini
AI_VISUALS_KEY=
AI_VISUALS_OPENAI_KEY=
AI_VISUALS_XAI_KEY=
# Defaults: gemini-3-pro-image | gpt-image-2.5-sunburst | grok-imagine-image-2.0.
# Catalog IDs are not proof of account access. Verify the chosen model in staging.
AI_VISUAL_MODEL=

# Image safety: default OFF, independent of text generation and paid checkout.
# Users must explicitly opt in and confirm the resolved provider on each brief.
AI_VISUALS_ENABLED=false
# Set a conservative positive USD upper bound for ONE high-quality scene request,
# including input/output charges. Verify current provider pricing yourself.
# A provider/model change invalidates the reservation until this binding is updated.
AI_VISUALS_GEMINI_COST_MODEL=
AI_VISUALS_GEMINI_MAX_USD_PER_IMAGE=
AI_VISUALS_OPENAI_COST_MODEL=
AI_VISUALS_OPENAI_MAX_USD_PER_IMAGE=
AI_VISUALS_XAI_COST_MODEL=
AI_VISUALS_XAI_MAX_USD_PER_IMAGE=

# Private immutable campaign bundles: rollout remains OFF until migration 0013,
# private bucket (no browser storage policies), CORS, export and GC staging checks.
# Rollback disables NEW uploads only; keep the new reader and cleanup deployed.
CAMPAIGN_ASSETS_ENABLED=false
CAMPAIGN_ASSET_BUCKET=

# No-provider vector corrections: OFF until migrations through 0023 and staged archive,
# restore, retention and browser checks pass. Disabling stops new corrections;
# retain the version-aware reader, restore RPCs and tables for existing edits.
VECTOR_CORRECTIONS_ENABLED=false

# Scoped client review links: enable only after migration 0016 and staging tests.
CLIENT_REVIEW_ENABLED=false

# Limited image-only recovery of recipe-backed inline/private fallbacks; apply through 0023 first.
IMAGE_RECOVERY_ENABLED=false

# Fail closed on missing public challenge key; Supabase must separately enforce CAPTCHA.
CAPTCHA_REQUIRED=false

# Optional first-party event counts: obtain policy approval and explicit user opt-in.
USAGE_METRICS_ENABLED=false
USAGE_METRICS_SECRET=

# Three-format AI-first campaigns. OFF until owner-approved staging/cost checks.
# Uses 3 x the model-bound per-image upper budget, including reference-input costs.
AI_CAMPAIGN_ENABLED=false
