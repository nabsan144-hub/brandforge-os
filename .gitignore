# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
dist/

# Local secrets and per-machine state — never commit
.env
.env.*
!.env.example

# Local output / generated campaign work
output/
*.log

# Test/coverage data
.coverage
coverage.xml

# sales build output (regenerated by npm run build on every deploy)
sales/public/

# App runtime state (auto-regenerated on first run; never commit)
app/brandforge_memory.db
app/active_client.json
app/memory/
app/agency_clients/

# Machine-local setup and credentials
app/setup-state.json
app/local-capability.token
app/.settings-transaction.json
app/config.json
app/license.json
app/approvals.json
qa-results/

# Python wheel build outputs
app/build/
app/*.egg-info/

# Disposable QA/build verification checkouts
.cache/

# Native runtime / installer build outputs
/native-candidate/
/installers/

# Ignore environment symlinks as well as directories.
node_modules
.venv
